{
  "name": "chatfolder",
  "version": "1.2.0",
  "private": true,
  "description": "A local-first Chrome extension that folds ChatGPT answers",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "pretest": "npm run build",
    "test": "tsx --test tests/*.test.ts",
    "debug:browser": "tsx scripts/devtools-session.mts",
    "test:browser-fixture": "tsx scripts/user-folding-fixture.mts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "chrome-devtools-mcp": "^1.12.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
