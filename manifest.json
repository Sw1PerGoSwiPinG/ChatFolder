{
  "manifest_version": 3,
  "name": "ChatFolder",
  "version": "1.2.2",
  "description": "收起 AI 的长篇回答，让问题成为对话目录。支持 ChatGPT，可逐条展开。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "ChatFolder",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "build/content/dom.js",
        "build/content/registry.js",
        "build/content/adapters/chatgpt.js",
        "build/content/user-fold.js",
        "build/content/engine.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
